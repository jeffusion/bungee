{
  "name": "@jeffusion/bungee-types",
  "version": "4.4.0",
  "description": "TypeScript type definitions for Bungee",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "bun run build && bun test tests/published-runtime.test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./daemon-file": {
      "types": "./dist/daemon-file.d.ts",
      "import": "./dist/daemon-file.js",
      "default": "./dist/daemon-file.js"
    }
  },
  "keywords": [
    "bungee",
    "types",
    "typescript"
  ],
  "files": [
    "dist/",
    "*.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffusion/bungee",
    "directory": "packages/types"
  },
  "license": "MIT",
  "devDependencies": {
    "bun-types": "^1.3.2",
    "typescript": "^5.7.2"
  }
}
