{
  "name": "@jeffusion/bungee-core",
  "version": "4.3.0",
  "description": "Bungee reverse proxy core engine",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "dev": "LOG_LEVEL=debug bun --watch src/main.ts",
    "build": "bun scripts/build.ts && bun run build:plugins && tsc -p tsconfig.build.json && bun scripts/finalize-declarations.ts",
    "build:plugins": "bun ../../scripts/build-external-plugins.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@jeffusion/bungee-types": "workspace:*",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "lodash-es": "^4.17.21",
    "dotenv": "^17.2.2",
    "@types/lodash-es": "^4.17.12",
    "acorn": "^8.15.0",
    "canonicalize": "3.0.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "bun-types": "^1.2.22"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "keywords": [
    "reverse-proxy",
    "proxy-server",
    "bun"
  ],
  "files": [
    "dist/main.js",
    "dist/main.d.ts",
    "dist/plugins",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffusion/bungee",
    "directory": "packages/core"
  },
  "license": "MIT"
}
