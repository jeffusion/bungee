{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "declarationDir": ".declarations",
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "paths": {
      "@jeffusion/bungee-core/plugin": ["./src/gateway/plugin.ts"],
      "@jeffusion/bungee-types": ["../types/dist/index.d.ts"],
      "@jeffusion/bungee-types/types": ["../types/dist/types.d.ts"],
      "@jeffusion/bungee-llms": ["../llms/dist/index.d.ts"],
      "@jeffusion/bungee-llms/plugin-api": ["../llms/dist/plugin-api.d.ts"]
    }
  },
  "files": ["src/main.ts"],
  "include": [],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"]
}
