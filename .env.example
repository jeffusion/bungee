# Public proxy/Ingress listener; public data port, proxy-only.
PORT=8088
WORKER_COUNT=2

# Master management listener. Standalone default is loopback; Docker Compose
# sets the container listener to 0.0.0.0 and publishes it on host loopback.
# BUNGEE_MANAGEMENT_HOST=127.0.0.1
# BUNGEE_MANAGEMENT_PORT=8089
# Docker host-side management mapping; change the published port if 8089 is busy.
# BUNGEE_MANAGEMENT_PUBLISH_HOST=127.0.0.1
# BUNGEE_MANAGEMENT_PUBLISH_PORT=8089

# Private master control listener: host is fixed to 127.0.0.1 and must never
# be published. Default port: 3011.
# BUNGEE_MASTER_CONTROL_PORT=3011

# Required for encrypted plugin credentials in standalone Docker. Set and keep stable.
# Generate once with:
# openssl rand -base64 32
BUNGEE_PLUGIN_SECRETS_KEY=

# Optional custom variable referenced by logical_configuration.auth; not a built-in Bungee variable.
# Set it yourself when authentication is enabled.
# BUNGEE_MANAGEMENT_TOKEN=

# Optional absolute SQLite paths.
# Configuration database (bungee.db), separate from telemetry (access.db).
# BUNGEE_CONFIG_DB_PATH=/absolute/path/to/data/bungee.db
# BUNGEE_ACCESS_DB_PATH=/absolute/path/to/logs/access.db
# Do not delete runtime lock files while Bungee is running.
