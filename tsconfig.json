{
  "compilerOptions": {
    "rootDir": ".",
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@jeffusion/bungee-core/plugin": ["packages/core/src/gateway/plugin.ts"],
      "@jeffusion/bungee-types": ["packages/types/src/index.ts"],
      "@jeffusion/bungee-types/types": ["packages/types/src/types.ts"],
      "@jeffusion/bungee-types/daemon-file": ["packages/types/src/daemon-file.ts"],
      "@jeffusion/bungee-llms": ["packages/llms/src/index.ts"],
      "@jeffusion/bungee-llms/plugin-api": ["packages/llms/src/plugin-api.ts"],
      "svelte": ["node_modules/svelte"],
      "svelte/*": ["node_modules/svelte/*"],
      "@bungee/plugin-sdk": ["packages/ui/src/plugin-sdk/index.ts"],
      "@plugins/*": ["plugins/*"],
      "$components": ["packages/ui/src/components"],
      "$components/*": ["packages/ui/src/components/*"],
      "$api": ["packages/ui/src/api"],
      "$api/*": ["packages/ui/src/api/*"],
      "$stores": ["packages/ui/src/stores"],
      "$stores/*": ["packages/ui/src/stores/*"],
      "$i18n": ["packages/ui/src/i18n"],
      "$i18n/*": ["packages/ui/src/i18n/*"],
      "$pluginSdk": ["packages/ui/src/plugin-sdk"],
      "$pluginSdk/*": ["packages/ui/src/plugin-sdk/*"],
      "$utils": ["packages/ui/src/utils.ts"],
      "$utils/*": ["packages/ui/src/utils/*"],
      "$validation": ["packages/ui/src/validation"],
      "$validation/*": ["packages/ui/src/validation/*"],
      "$types": ["packages/ui/src/types"],
      "$types/*": ["packages/ui/src/types/*"],
      "$hooks": ["packages/ui/src/hooks"],
      "$hooks/*": ["packages/ui/src/hooks/*"],
      "$lib": ["packages/ui/src"],
      "$lib/*": ["packages/ui/src/*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun-types", "node", "bun", "jest"],
    "typeRoots": ["node_modules/@types", "node_modules"],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "packages/ui/src/**/*.js"],
  "exclude": ["node_modules", "**/node_modules", "**/dist"]
}
