  "builtin": true,
  "services": {
    "consumes": [
      {
        "plugin": "token-metering",
        "id": "token-metering.v1",
        "version": 1,
        "process": "worker"
      }
    ],
    "provides": [
      {
        "id": "token-stats.pricing.v1",
        "version": 1,
        "process": "worker"
      }
    ]
  }
}
