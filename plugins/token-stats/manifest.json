{
  "name": "token-stats",
  "version": "3.2.0",
  "author": "Bungee Team",
  "schemaVersion": 2,
  "artifactKind": "runtime-plugin",
  "control": {
    "entry": "server/control.ts",
    "rpc": []
  },
  "capabilities": [
    "hooks",
    "api",
    "nativeWidgetsStatic",
    "dynamicRuntimeLoad",
    "controlPlane"
  ],
  "runtimeScope": "global",
  "uiExtensionMode": "native-static",
  "engines": {
    "bungee": "^5.0.0"
  },
  "main": "server/index.ts",
  "metadata": {
    "name": "metadata.name",
    "description": "plugin.description",
    "icon": "bar_chart"
  },
  "ui": {
    "components": [
      {
        "name": "TokenStatsChart",
        "entry": "ui/TokenStatsChart.svelte"
      },
      {
        "name": "TokenStatsSettings",
        "entry": "ui/TokenStatsSettings.svelte"
      },
      {
        "name": "TokenStatsMetric",
        "entry": "ui/TokenStatsMetric.svelte"
      },
      {
        "name": "TokenStatsPage",
        "entry": "ui/TokenStatsPage.svelte"
      }
    ]
  },
  "configSchema": [],
  "contributes": {
    "nativeWidgets": [
      {
        "id": "token-stats-overview",
        "title": "widgets.overview.title",
        "size": "medium",
        "component": "TokenStatsMetric",
        "presentation": "kpi"
      },
      {
        "id": "token-stats-time",
        "title": "widgets.time.title",
        "size": "full",
        "component": "TokenStatsChart"
      }
    ],
    "api": [
      {
        "path": "/stats",
        "methods": [
          "GET"
        ],
        "handler": "getStats",
        "execution": "control"
      },
      {
        "path": "/pricing",
        "methods": [
          "GET"
        ],
        "handler": "getPricing",
        "execution": "control"
      },
      {
        "path": "/pricing/settings",
        "methods": [
          "PUT"
        ],
        "handler": "configurePricing",
        "execution": "control"
      },
      {
        "path": "/pricing/refresh",
        "methods": [
          "POST"
        ],
        "handler": "refreshPricing",
        "execution": "control"
      }
    ],
    "settings": "/pricing",
    "nativeSettingsComponent": "TokenStatsSettings",
    "navigation": [
      {
        "label": "page.title",
        "path": "/statistics",
        "component": "TokenStatsPage",
        "target": "header",
        "icon": "bar_chart"
      }
    ]
  },
