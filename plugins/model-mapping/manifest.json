{
  "name": "model-mapping",
  "version": "2.0.0",
  "author": "Bungee Team",
  "builtin": true,
  "schemaVersion": 3,
  "artifactKind": "runtime-plugin",
  "main": "server/index.ts",
  "control": {
    "entry": "server/control.ts",
    "rpc": []
  },
  "capabilities": ["hooks", "api", "dynamicRuntimeLoad", "controlPlane"],
  "uiExtensionMode": "none",
  "engines": {
    "bungee": "^6.0.0"
  },
  "metadata": {
    "name": "metadata.name",
    "description": "plugin.description",
    "icon": "compare_arrows"
  },
  "dependencies": {
    "models-dev": "^1.0.0"
  },
  "services": {
    "consumes": [
      {
        "plugin": "models-dev",
        "id": "models-dev.catalog.v1",
        "version": 1,
        "process": "control",
        "kind": "local"
      },
      {
        "plugin": "models-dev",
        "id": "models-dev.catalog.v1",
        "version": 1,
        "process": "worker",
        "kind": "local"
      }
    ]
  },
  "configSchema": [
    {
      "name": "modelMappings",
      "type": "model_mapping",
      "label": "modelMapping.label",
      "description": "modelMapping.description",
      "placeholder": "modelMapping.placeholder",
      "catalogPlugin": "model-mapping"
    }
  ],
  "contributes": {
    "settings": "/catalog",
    "api": [
      { "path": "/catalog", "methods": ["GET"], "handler": "getCatalog", "execution": "control", "capability": "config.read" }
    ]
  },
  "translations": {
    "en": {
      "metadata.name": "Model Mapping",
      "plugin.description": "Map source models to target models using the shared models.dev catalog",
      "modelMapping.label": "Model Mapping",
      "modelMapping.description": "Set the source name and exact upstream name. Optionally associate a models.dev catalog identity.",
      "modelMapping.placeholder": "Add source and target model mapping",
      "modelMapping.sourceLabel": "Model name in request",
      "modelMapping.sourceHint": "Enter a name or find it in the catalog.",
      "modelMapping.targetLabel": "Model name sent upstream",
      "modelMapping.targetHint": "Letter case is preserved.",
      "modelMapping.rule": "Rule",
      "modelMapping.catalogAssociation": "Capability catalog (optional)",
      "modelMapping.unassociated": "Not associated",
      "modelMapping.associateCatalog": "Associate catalog model",
      "modelMapping.changeCatalog": "Change",
      "modelMapping.selectCatalog": "Select capability catalog",
      "modelMapping.catalogLabel": "Catalog model",
      "modelMapping.catalogHint": "Checks reasoning and protocol capabilities without changing the upstream name.",
      "modelMapping.catalogProviderFilter": "Catalog provider filter",
      "modelMapping.clearCatalog": "Clear association",
      "modelMapping.catalogPlaceholder": "Select a catalog model (optional)",
      "modelMapping.search": "Search models",
      "modelMapping.loading": "Loading models",
      "modelMapping.error": "Unable to load models",
      "modelMapping.retry": "Retry",
      "modelMapping.loaded": "Loaded",
      "modelMapping.complete": "All loaded",
      "modelMapping.loadMore": "Load more",
      "modelMapping.noOptions": "No matching models",
      "modelMapping.custom": "Use custom name:",
      "modelMapping.sourceProviderFilter": "Source provider filter",
      "modelMapping.targetProviderFilter": "Target provider filter",
      "modelMapping.allProviders": "All providers",
      "modelMapping.addRow": "Add mapping",
      "modelMapping.empty": "No model mappings configured"
    },
    "zh-CN": {
      "metadata.name": "模型映射",
      "plugin.description": "使用共享的 models.dev 目录将源模型映射到目标模型",
      "modelMapping.label": "模型映射",
      "modelMapping.description": "设置源名称与准确的上游名称，可选关联 models.dev 目录身份。",
      "modelMapping.placeholder": "添加源模型与目标模型映射",
      "modelMapping.sourceLabel": "请求中的模型名称",
      "modelMapping.sourceHint": "输入名称，或从目录中查找。",
      "modelMapping.targetLabel": "发给上游的模型名称",
      "modelMapping.targetHint": "保留输入的大小写。",
      "modelMapping.rule": "规则",
      "modelMapping.catalogAssociation": "能力校验目录（可选）",
      "modelMapping.unassociated": "未关联",
      "modelMapping.associateCatalog": "关联目录模型",
      "modelMapping.changeCatalog": "更换",
      "modelMapping.selectCatalog": "选择能力校验目录",
      "modelMapping.catalogLabel": "目录模型",
      "modelMapping.catalogHint": "用于推理和协议能力校验，不改写上游名称。",
      "modelMapping.catalogProviderFilter": "目录提供商筛选",
