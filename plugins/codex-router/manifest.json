{
  "name": "codex-router",
  "version": "1.0.0",
  "author": "Bungee Team",
  "builtin": true,
  "schemaVersion": 3,
  "artifactKind": "runtime-plugin",
  "main": "server/index.ts",
  "control": {
    "entry": "server/control.ts",
    "rpc": []
  },
  "capabilities": [
    "hooks",
    "api",
    "dynamicRuntimeLoad",
    "controlPlane"
  ],
  "engines": {
    "bungee": "^6.0.0"
  },
  "metadata": {
    "name": "metadata.name",
    "description": "plugin.description",
    "icon": "alt_route"
  },
  "dependencies": {
    "models-dev": "^1.0.0",
    "llm-protocol-adapter": "^1.0.0"
  },
  "services": {
    "consumes": [
      {
        "plugin": "models-dev",
        "id": "models-dev.catalog.v1",
        "version": 1,
        "process": "control",
        "kind": "local"
      },
      {
        "plugin": "models-dev",
        "id": "models-dev.capabilities.v1",
        "version": 1,
        "process": "control",
        "kind": "local"
      },
      {
        "plugin": "llm-protocol-adapter",
        "id": "llm-protocol-adapter.conversion.v1",
        "version": 1,
        "process": "control",
        "kind": "local"
      },
      {
        "plugin": "llm-protocol-adapter",
        "id": "llm-protocol-adapter.conversion.v1",
        "version": 1,
        "process": "worker",
        "kind": "local"
      },
      {
        "plugin": "llm-protocol-adapter",
        "id": "llm-protocol-adapter.history.v1",
        "version": 1,
        "process": "worker",
        "kind": "rpc"
      },
      {
        "plugin": "codex-router",
        "id": "codex-router.catalog-validators.v1",
        "version": 1,
        "process": "worker",
        "kind": "rpc"
      }
    ],
    "provides": [
      {
        "id": "codex-router.catalog-validators.v1",
        "version": 1,
        "process": "control",
        "kind": "rpc"
      }
    ]
  },
  "configSchema": [
    {
      "name": "models",
      "type": "array",
      "label": "models.label",
      "default": [],
      "validation": {
        "max": 100
      },
      "items": {
        "name": "binding",
        "type": "object",
        "label": "Model",
        "properties": [
          {
            "name": "source",
            "type": "string",
            "label": "editor.source",
            "required": false,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "sourceProvider",
            "type": "string",
            "label": "editor.sourceProvider",
            "required": false,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "sourceProtocol",
            "type": "select",
            "label": "editor.sourceProtocol",
            "options": [
              {
                "value": "responses",
                "label": "Responses"
              }
            ]
          },
          {
            "name": "provider",
            "type": "string",
            "label": "editor.provider",
            "required": true,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "model",
            "type": "string",
            "label": "editor.model",
            "required": true,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "alias",
            "type": "string",
            "label": "alias",
            "required": false,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "target",
            "type": "gateway_target",
            "label": "editor.target",
            "required": true
          },
          {
            "name": "capabilityOverrides",
            "type": "json",
            "label": "editor.advanced"
          }
        ]
      }
    },
    {
      "name": "collaborationRelay",
      "type": "object",
      "label": "relay.label",
      "properties": [
        {
          "name": "target",
          "type": "gateway_target",
          "label": "relay.target",
          "required": true
        },
        {
          "name": "model",
          "type": "string",
          "label": "relay.model",
          "required": true,
          "validation": {
            "trimmed": true,
            "max": 512
          }
        }
      ]
    }
  ],
  "contributes": {
    "api": [
      {
        "path": "/catalog",
        "methods": [
          "GET"
        ],
        "handler": "getCatalog",
        "execution": "control",
        "capability": "config.read"
      }
    ]
  },
