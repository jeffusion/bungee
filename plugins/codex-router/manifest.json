{
  "name": "codex-router",
  "version": "1.0.0",
  "author": "Bungee Team",
  "builtin": true,
  "schemaVersion": 3,
  "artifactKind": "runtime-plugin",
  "main": "server/index.ts",
  "control": {
    "entry": "server/control.ts",
    "rpc": []
  },
  "capabilities": [
    "hooks",
    "api",
    "dynamicRuntimeLoad",
    "controlPlane",
    "nativeWidgetsStatic"
  ],
  "uiExtensionMode": "native-static",
  "engines": {
    "bungee": "^4.2.0 || ^5.0.0"
  },
  "metadata": {
    "name": "metadata.name",
    "description": "plugin.description",
    "icon": "alt_route"
  },
  "dependencies": {
    "models-dev": "^1.0.0"
  },
  "services": {
    "consumes": [
      {
        "plugin": "models-dev",
        "id": "models-dev.catalog.v1",
        "version": 1,
        "process": "control",
        "kind": "local"
      },
      {
        "plugin": "models-dev",
        "id": "models-dev.catalog.v1",
        "version": 1,
        "process": "worker",
        "kind": "local"
      },
      {
        "plugin": "models-dev",
        "id": "models-dev.capabilities.v1",
        "version": 1,
        "process": "control",
        "kind": "local"
      },
      {
        "plugin": "models-dev",
        "id": "models-dev.capabilities.v1",
        "version": 1,
        "process": "worker",
        "kind": "local"
      },
      {
        "plugin": "codex-router",
        "id": "codex-router.history.v1",
        "version": 1,
        "process": "worker",
        "kind": "rpc"
      }
    ],
    "provides": [
      {
        "id": "codex-router.history.v1",
        "version": 1,
        "process": "control",
        "kind": "rpc"
      }
    ]
  },
  "configSchema": [
    {
      "name": "models",
      "type": "array",
      "label": "plugins.codex-router.models.label",
      "default": [],
      "validation": {
        "max": 100
      },
      "items": {
        "name": "binding",
        "type": "object",
        "label": "Model",
        "properties": [
          {
            "name": "source",
            "type": "string",
            "label": "plugins.codex-router.editor.source",
            "required": false,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "provider",
            "type": "string",
            "label": "plugins.codex-router.editor.provider",
            "required": true,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "model",
            "type": "string",
            "label": "plugins.codex-router.editor.model",
            "required": true,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "alias",
            "type": "string",
            "label": "alias",
            "required": false,
            "validation": {
              "trimmed": true,
              "max": 512
            }
          },
          {
            "name": "target",
            "type": "gateway_target",
            "label": "plugins.codex-router.editor.target",
            "required": true
          },
          {
            "name": "capabilityOverrides",
            "type": "json",
            "label": "plugins.codex-router.editor.capabilityOverrides"
          }
        ]
      }
    }
  ],
  "contributes": {
    "settings": "/catalog",
    "nativeSettingsComponent": "CodexRouterSettings",
    "api": [
      {
        "path": "/catalog",
        "methods": [
          "GET"
        ],
        "handler": "getCatalog",
        "execution": "control",
        "capability": "config.read"
      }
    ]
  },
  "translations": {
    "zh-CN": {
